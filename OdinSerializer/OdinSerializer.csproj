<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>OdinSerializer</RootNamespace>
        <AssemblyName>OdinSerializer</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>OdinSerializerForGodot</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Authors>molingyu</Authors>
        <Description>High-performance binary/JSON serialization for Godot C#, ported from OdinSerializer. Ships the serialization runtime as a library; the SerializedNode/SerializedResource base classes are distributed as source via the addons/odin_serializer Godot addon (Godot does not support script classes inheriting GodotObject types from referenced assemblies).</Description>
        <PackageProjectUrl>https://github.com/molingyu/OdinSerializerForGodot</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/molingyu/OdinSerializerForGodot</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Godot;serialization;odin</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>latest</LangVersion>
        <TargetFramework>net8.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Debug;Release;ReleaseGodot;DebugUnity;ReleaseUnity;DebugGodot</Configurations>
        <Platforms>AnyCPU</Platforms>
        <Company>Sirenix IVS</Company>
        <Copyright>Copyright © 2018</Copyright>
    </PropertyGroup>

    <!-- Map the default Debug/Release configurations to the Godot build so a plain dotnet build works out of the box -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' Or '$(Configuration)' == 'ReleaseGodot' ">
        <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
        <DefineConstants>GODOT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(Configuration)' == 'DebugGodot' ">
        <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
        <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
        <DefineConstants>TRACE;DEBUG;GODOT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'DebugUnity' ">
        <DefineConstants>TRACE;DEBUG;UNITY</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'ReleaseUnity' ">
        <DefineConstants>UNITY</DefineConstants>
    </PropertyGroup>
    
    <ItemGroup Condition=" '$(Configuration)|$(Platform)' == 'DebugUnity|AnyCPU' OR '$(Configuration)|$(Platform)' == 'ReleaseUnity|AnyCPU' ">
        <Reference Include="UnityEditor">
            <HintPath>..\Libraries\Unity\UnityEditor.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>..\Libraries\Unity\UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>..\Libraries\Unity\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule">
            <HintPath>..\Libraries\Unity\UnityEngine.AnimationModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>..\Libraries\Unity\UnityEngine.JSONSerializeModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Compile Remove="Engine Integration\Godot\**\*.cs" />
    </ItemGroup>

    <ItemGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' OR '$(Configuration)|$(Platform)' == 'Release|AnyCPU' OR '$(Configuration)|$(Platform)' == 'DebugGodot|AnyCPU' OR '$(Configuration)|$(Platform)' == 'ReleaseGodot|AnyCPU' ">
        <PackageReference Include="GodotSharp" Version="4.6.2" />
        <Compile Remove="Engine Integration\Unity\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>